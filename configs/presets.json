  "weights.q50l30c20": {"w_quality": 0.5, "w_latency": 0.3, "w_cost": 0.2},
  "weights.q60l20c20": {"w_quality": 0.6, "w_latency": 0.2, "w_cost": 0.2},
  "weights.q80l10c10": {"w_quality": 0.8, "w_latency": 0.1, "w_cost": 0.1},

  "rounds.adaptive": {"adaptive": true, "max_batch": null, "timeout_ms": null},
  "rounds.fixed1": {"adaptive": false, "max_batch": 1, "timeout_ms": 50.0},
  "rounds.fixed32": {"adaptive": false, "max_batch": 32, "timeout_ms": 200.0},
  "telemetry": {"poll_ms": 50.0, "timeout_s": 1.0},
  "budget.off": {"admission_filter": false},
  "budget.filter": {"admission_filter": true},
  "rb.pending_decode": "own_length",

  "encoder_revision": "1110a243fdf4706b3f48f1d95db1a4f5529b4d41",
  "estimator.knn": {"index_dir": "$pin:knn.{family}:path", "index_md5": "$pin:knn.{family}:md5",
                    "encoder_revision": "$part:encoder_revision", "k": 50, "score_type": "deepeval", "prior": "knn"},
  "estimator.prompt_blind": {"index_dir": "$pin:knn.{family}:path", "index_md5": "$pin:knn.{family}:md5",
                             "encoder_revision": "$part:encoder_revision", "k": 50, "score_type": "deepeval",
                             "prior": "per_model_mean"},
  "estimator.sweep": {"index_dir": "$pin:knn.{family}:path", "index_md5": "$pin:knn.{family}:md5", "encoder_revision": "$part:encoder_revision", "k": 50, "score_type": "deepeval", "prior": "knn"},
  "estimator.half_labels": {"index_dir": "$pin:knn-half.{family}:path", "index_md5": "$pin:knn-half.{family}:md5",
                            "encoder_revision": "$part:encoder_revision", "k": 50, "score_type": "deepeval",
                            "prior": "knn"},
  "estimator.lodo.beaver_tails": {"index_dir": "$pin:knn-lodo-beaver_tails.{family}:path", "index_md5": "$pin:knn-lodo-beaver_tails.{family}:md5",
                            "encoder_revision": "$part:encoder_revision", "k": 50, "score_type": "deepeval",
                            "prior": "knn"},
  "estimator.lodo.code_ultra_feedback": {"index_dir": "$pin:knn-lodo-code_ultra_feedback.{family}:path", "index_md5": "$pin:knn-lodo-code_ultra_feedback.{family}:md5",
                            "encoder_revision": "$part:encoder_revision", "k": 50, "score_type": "deepeval",
                            "prior": "knn"},
  "estimator.lodo.gsm8k": {"index_dir": "$pin:knn-lodo-gsm8k.{family}:path", "index_md5": "$pin:knn-lodo-gsm8k.{family}:md5",
                            "encoder_revision": "$part:encoder_revision", "k": 50, "score_type": "deepeval",
                            "prior": "knn"},
  "estimator.lodo.lmsys": {"index_dir": "$pin:knn-lodo-lmsys.{family}:path", "index_md5": "$pin:knn-lodo-lmsys.{family}:md5",
                            "encoder_revision": "$part:encoder_revision", "k": 50, "score_type": "deepeval",
                            "prior": "knn"},
  "estimator.lodo.mix_instruct": {"index_dir": "$pin:knn-lodo-mix_instruct.{family}:path", "index_md5": "$pin:knn-lodo-mix_instruct.{family}:md5",
                            "encoder_revision": "$part:encoder_revision", "k": 50, "score_type": "deepeval",
                            "prior": "knn"},
  "estimator.lodo.reward_bench": {"index_dir": "$pin:knn-lodo-reward_bench.{family}:path", "index_md5": "$pin:knn-lodo-reward_bench.{family}:md5",
                            "encoder_revision": "$part:encoder_revision", "k": 50, "score_type": "deepeval",
                            "prior": "knn"},
  "estimator.lodo.squad": {"index_dir": "$pin:knn-lodo-squad.{family}:path", "index_md5": "$pin:knn-lodo-squad.{family}:md5",
                            "encoder_revision": "$part:encoder_revision", "k": 50, "score_type": "deepeval",
                            "prior": "knn"},

  "prefill": {"table": "$pin:prefill-table.{family}:path", "table_md5": "$pin:prefill-table.{family}:md5"},
  "latency.curve": {"source": "profiled_curve", "envelope": "batch_aware", "normalization": "fixed_ref",
                    "table": "$pin:tpot-table.{family}:path", "table_md5": "$pin:tpot-table.{family}:md5",
                    "prefill": "$part:prefill"},
  "latency.static": {"source": "constant", "envelope": "queue_aware", "normalization": "max_divide",
                     "table": "$pin:tpot-table.{family}:path", "table_md5": "$pin:tpot-table.{family}:md5",
