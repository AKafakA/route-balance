              "latency": "$part:latency.{arm}", "estimator": "$part:estimator.knn", "budget": "$part:budget.off",
              "telemetry": "$part:telemetry", "pipeline": null}},
  {"id": "{family}.{arm}.abl-wc0.{w}", "axes": {"family": "$list:all_families", "arm": "$list:rb_arms", "w": "$list:rb_weights"},
   "system": "RouteBalance-abl-wc0", "knob": "{w}", "dispatch": "joint", "ablates": ["system.weights.*"],
   "config": {"mode": "routebalance", "normalize_over": "$part:rb.normalize_over", "weights": "$without:w_cost:weights.{w}", "rounds": "$part:rounds.adaptive",
              "lpt": "max", "pending_decode": "$part:rb.pending_decode", "dead_reckoning": true, "telemetry_read": "per_round",
              "latency": "$part:latency.{arm}", "estimator": "$part:estimator.knn", "budget": "$part:budget.off",
              "telemetry": "$part:telemetry", "pipeline": null}},
  {"id": "{family}.abl-const-batch.{w}", "axes": {"family": "$list:all_families", "w": "$list:rb_weights"},
   "system": "RouteBalance-abl-const-batch", "knob": "{w}", "dispatch": "joint", "ablates": ["system.latency.*"],
   "config": {"mode": "routebalance", "normalize_over": "$part:rb.normalize_over", "weights": "$part:weights.{w}", "rounds": "$part:rounds.adaptive", "lpt": "max",
              "pending_decode": "$part:rb.pending_decode", "dead_reckoning": true, "telemetry_read": "per_round", "latency": "$part:latency.const_batch",
              "estimator": "$part:estimator.knn", "budget": "$part:budget.off", "telemetry": "$part:telemetry",
              "pipeline": null}},
  {"id": "{family}.{arm}{nv}.abl-lpt-{k}.{w}", "axes": {"nv": "$list:rb_norms", "family": "$list:all_families", "arm": "$list:rb_arms", "k": ["min", "mean"], "w": "$list:rb_weights_all"},
   "system": "RouteBalance{nv}-abl-lpt-{k}", "knob": "{w}", "dispatch": "joint", "ablates": ["system.lpt"],
   "config": {"mode": "routebalance", "normalize_over": "$part:rb.normalize_over{nv}", "weights": "$part:weights.{w}", "rounds": "$part:rounds.adaptive", "lpt": "{k}",
              "pending_decode": "$part:rb.pending_decode", "dead_reckoning": true, "telemetry_read": "per_round", "latency": "$part:latency.{arm}",
              "estimator": "$part:estimator.knn", "budget": "$part:budget.off", "telemetry": "$part:telemetry",
              "pipeline": null}}
 ]
}
