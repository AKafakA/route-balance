  "weights.q10l80c10": {"w_quality": 0.1, "w_latency": 0.8, "w_cost": 0.1},
  "weights.q20l20c60": {"w_quality": 0.2, "w_latency": 0.2, "w_cost": 0.6},
  "weights.q20l60c20": {"w_quality": 0.2, "w_latency": 0.6, "w_cost": 0.2},
