  "dispatch.rr": {"type": "round_robin", "seed": "$part:dispatch.seed", "latency_window": null, "count": null},
  "dispatch.po2": {"type": "po2", "seed": "$part:dispatch.seed", "latency_window": null, "count": "engine"},
  "dispatch.random": {"type": "random", "seed": "$part:dispatch.seed", "latency_window": null, "count": null},
  "dispatch.lowest-latency": {"type": "lowest_latency", "seed": "$part:dispatch.seed", "latency_window": 10, "count": null},
  "dispatch.lor-inflight": {"type": "least_outstanding", "seed": "$part:dispatch.seed", "latency_window": null, "count": "in_flight"},
  "dispatch.po2-inflight": {"type": "po2", "seed": "$part:dispatch.seed", "latency_window": null, "count": "in_flight"},

  "ap.router": {"type": "avengers_pro", "kwargs": {"artifact_dir": "$pin:ap.{family}.{pw}:path", "beta": 9.0,
                "top_k": 1, "embedder": "sentence-transformers/all-MiniLM-L6-v2",
                "embedder_revision": "$part:encoder_revision",
                "upstream_sha256": "6cfaf58f525217b47c2e90361fbb3e94309f66fbbc7eadef067e01c82946493b",
                "max_tokens": 7500, "max_workers": 4}, "concurrency": 32},
  "ap.router.shipped": {"type": "avengers_pro", "kwargs": {"artifact_dir": "$pin:ap.{family}.{pw}:path", "beta": 9.0,
                        "top_k": 1, "embedder": "sentence-transformers/all-MiniLM-L6-v2",
                        "embedder_revision": "$part:encoder_revision",
                        "upstream_sha256": "6cfaf58f525217b47c2e90361fbb3e94309f66fbbc7eadef067e01c82946493b",
                        "max_tokens": 7500, "max_workers": 4}, "concurrency": 1},
  "br.threshold.t00": 0.0,
  "br.threshold.t03": 0.3,
  "br.threshold.t05": 0.5,
  "br.threshold.t07": 0.7,
  "br.fallback.qwen": "Qwen/Qwen2.5-3B",
  "br.fallback.gemma": "google/gemma-3-4b-it",
  "br.router": {"type": "best_route_upstream", "kwargs": {"checkpoint": "$pin:br.{family}:path",
                "threshold": "$part:br.threshold.{t}", "base_model": "microsoft/deberta-v3-small",
                "base_revision": "a36c739020e01763fe789b4b85e2df55d6180012",
                "upstream_sha256": "85279e1f6080d87db95dcbded46d7713fcf2728b82339c3b6a30ef3b56579005"}, "concurrency": 32},
  "br.router.shipped": {"type": "best_route_upstream", "kwargs": {"checkpoint": "$pin:br.{family}:path",
                        "threshold": "$part:br.threshold.{t}", "base_model": "microsoft/deberta-v3-small",
                        "base_revision": "a36c739020e01763fe789b4b85e2df55d6180012",
                        "upstream_sha256": "85279e1f6080d87db95dcbded46d7713fcf2728b82339c3b6a30ef3b56579005"}, "concurrency": 1},
  "br.router.v3": {"type": "best_route", "kwargs": {"checkpoint": "$pin:br-v3.{family}:path",
                   "confidence_threshold": "$part:br.threshold.{t}", "fallback_model": "$part:br.fallback.{family}",
                   "max_length": 512}, "concurrency": 32},
  "rb.normalize_over": "round",
  "rb.normalize_over.request": "request",
  "rb-dec.router": {"type": "rb_decoupled", "kwargs": {}, "concurrency": 32},
  "rb-dec.router.shipped": {"type": "rb_decoupled", "kwargs": {}, "concurrency": 1}
 },
 "templates": [
  {"id": "{family}.rb.{w}", "axes": {"family": "$list:all_families", "w": "$list:rb_weights"},
   "system": "RouteBalance", "knob": "{w}", "dispatch": "joint", "ablates": ["system.latency.*"],
   "config": {"mode": "routebalance", "normalize_over": "$part:rb.normalize_over", "weights": "$part:weights.{w}", "rounds": "$part:rounds.adaptive", "lpt": "max",
              "pending_decode": "$part:rb.pending_decode", "dead_reckoning": true, "telemetry_read": "per_round", "latency": "$part:latency.curve",
              "estimator": "$part:estimator.knn", "budget": "$part:budget.off", "telemetry": "$part:telemetry",
              "pipeline": null}},
  {"id": "{family}.rb-budget.{w}", "axes": {"family": "$list:all_families", "w": ["uniform"]},
   "system": "RouteBalance-budget", "knob": "{w}", "dispatch": "joint", "ablates": [],
   "config": {"mode": "routebalance", "normalize_over": "$part:rb.normalize_over", "weights": "$part:weights.{w}", "rounds": "$part:rounds.adaptive", "lpt": "max",
              "pending_decode": "$part:rb.pending_decode", "dead_reckoning": true, "telemetry_read": "per_round", "latency": "$part:latency.curve",
              "estimator": "$part:estimator.knn", "budget": "$part:budget.filter", "telemetry": "$part:telemetry",
              "pipeline": null}},
  {"id": "{family}.rb-static-budget.{w}", "axes": {"family": "$list:all_families", "w": ["uniform"]},
   "system": "RouteBalance-static-budget", "knob": "{w}", "dispatch": "joint", "ablates": [],
   "config": {"mode": "routebalance", "normalize_over": "$part:rb.normalize_over", "weights": "$part:weights.{w}", "rounds": "$part:rounds.adaptive", "lpt": "max",
              "pending_decode": "$part:rb.pending_decode", "dead_reckoning": true, "telemetry_read": "per_round", "latency": "$part:latency.static",
              "estimator": "$part:estimator.knn", "budget": "$part:budget.filter", "telemetry": "$part:telemetry",
              "pipeline": null}},
  {"id": "{family}.rb-learned-budget.{w}", "axes": {"family": "$list:qwen_only", "w": ["uniform"]},
   "system": "RouteBalance-learned-budget", "knob": "{w}", "dispatch": "joint", "ablates": [],
   "config": {"mode": "routebalance", "normalize_over": "$part:rb.normalize_over", "weights": "$part:weights.{w}", "rounds": "$part:rounds.adaptive", "lpt": "max",
              "pending_decode": "$part:rb.pending_decode", "dead_reckoning": true, "telemetry_read": "per_round", "latency": "$part:latency.xgb",
              "estimator": "$part:estimator.knn", "budget": "$part:budget.filter", "telemetry": "$part:telemetry",
              "pipeline": null}},
  {"id": "{family}.rb-poll.{w}", "axes": {"family": "$list:all_families", "w": "$list:rb_weights"},
   "system": "RouteBalance-poll", "knob": "{w}", "dispatch": "joint", "ablates": [],
   "config": {"mode": "routebalance", "normalize_over": "$part:rb.normalize_over", "weights": "$part:weights.{w}", "rounds": "$part:rounds.adaptive", "lpt": "max",
              "pending_decode": "$part:rb.pending_decode", "dead_reckoning": true, "telemetry_read": "poll", "latency": "$part:latency.curve",
              "estimator": "$part:estimator.knn", "budget": "$part:budget.off", "telemetry": "$part:telemetry",
              "pipeline": null}},
  {"id": "{family}.rb-static.{w}", "axes": {"family": "$list:all_families", "w": "$list:rb_weights"},
   "system": "RouteBalance-static", "knob": "{w}", "dispatch": "joint", "ablates": ["system.latency.*"],
   "config": {"mode": "routebalance", "normalize_over": "$part:rb.normalize_over", "weights": "$part:weights.{w}", "rounds": "$part:rounds.adaptive", "lpt": "max",
              "pending_decode": "$part:rb.pending_decode", "dead_reckoning": true, "telemetry_read": "per_round", "latency": "$part:latency.static",
              "estimator": "$part:estimator.knn", "budget": "$part:budget.off", "telemetry": "$part:telemetry",
              "pipeline": null}},
  {"id": "{family}.{arm}-reqnorm.{w}", "axes": {"family": "$list:all_families", "arm": "$list:rb_arms", "w": "$list:rb_weights"},
   "system": "RouteBalance-reqnorm", "knob": "{w}", "dispatch": "joint", "ablates": ["system.normalize_over"],
   "config": {"mode": "routebalance", "normalize_over": "$part:rb.normalize_over.request", "weights": "$part:weights.{w}", "rounds": "$part:rounds.adaptive", "lpt": "max",
              "pending_decode": "$part:rb.pending_decode", "dead_reckoning": true, "telemetry_read": "per_round", "latency": "$part:latency.{arm}",
              "estimator": "$part:estimator.knn", "budget": "$part:budget.off", "telemetry": "$part:telemetry",
              "pipeline": null}},
  {"id": "{family}.rb-learned.{w}", "axes": {"family": "$list:qwen_only", "w": "$list:rb_weights"},
   "system": "RouteBalance-learned", "knob": "{w}", "dispatch": "joint", "ablates": ["system.latency.*"],
   "config": {"mode": "routebalance", "normalize_over": "$part:rb.normalize_over", "weights": "$part:weights.{w}", "rounds": "$part:rounds.adaptive", "lpt": "max",
              "pending_decode": "$part:rb.pending_decode", "dead_reckoning": true, "telemetry_read": "per_round", "latency": "$part:latency.xgb",
              "estimator": "$part:estimator.knn", "budget": "$part:budget.off", "telemetry": "$part:telemetry",
              "pipeline": null}},
  {"id": "{family}.rb-static-poll.{w}", "axes": {"family": "$list:all_families", "w": "$list:rb_weights"},
   "system": "RouteBalance-static-poll", "knob": "{w}", "dispatch": "joint", "ablates": ["system.latency.source", "system.latency.envelope", "system.latency.normalization"],
   "config": {"mode": "routebalance", "normalize_over": "$part:rb.normalize_over", "weights": "$part:weights.{w}", "rounds": "$part:rounds.adaptive", "lpt": "max",
              "pending_decode": "$part:rb.pending_decode", "dead_reckoning": true, "telemetry_read": "poll", "latency": "$part:latency.static",
              "estimator": "$part:estimator.knn", "budget": "$part:budget.off", "telemetry": "$part:telemetry",
              "pipeline": null}},
  {"id": "{family}.rb-dec.{w}", "axes": {"family": "$list:all_families", "w": "$list:rb_weights"},
   "system": "RB-decoupled", "knob": "{w}", "dispatch": "lor", "ablates": [],
   "config": {"mode": "pipeline", "normalize_over": null, "weights": "$part:weights.{w}", "rounds": "$part:rounds.adaptive", "lpt": "max",
              "pending_decode": null, "dead_reckoning": false, "telemetry_read": "poll", "latency": "$part:latency.curve",
